{
  "contrato": {
    "nombre": "contrato_datos_iris_random_forest",
    "version": "1.0.0",
    "descripcion": "Contrato de datos oficial para la inferencia del modelo RandomForestClassifier entrenado sobre el dataset Iris (experimento MLflow 'Proyecto_Final_Grado').",
    "formato": "JSON (un objeto por solicitud de inferencia)"
  },
  "entrada": {
    "campos_extra_permitidos": false,
    "campos": [
      {
        "nombre": "sepal_length_cm",
        "descripcion": "Largo del sépalo",
        "tipo": "float",
        "unidad": "cm",
        "obligatorio": true,
        "nulos_permitidos": false,
        "min": 4.0,
        "max": 8.5
      },
      {
        "nombre": "sepal_width_cm",
        "descripcion": "Ancho del sépalo",
        "tipo": "float",
        "unidad": "cm",
        "obligatorio": true,
        "nulos_permitidos": false,
        "min": 1.5,
        "max": 5.0
      },
      {
        "nombre": "petal_length_cm",
        "descripcion": "Largo del pétalo",
        "tipo": "float",
        "unidad": "cm",
        "obligatorio": true,
        "nulos_permitidos": false,
        "min": 0.5,
        "max": 7.5
      },
      {
        "nombre": "petal_width_cm",
        "descripcion": "Ancho del pétalo",
        "tipo": "float",
        "unidad": "cm",
        "obligatorio": true,
        "nulos_permitidos": false,
        "min": 0.0,
        "max": 3.0
      }
    ],
    "orden_para_el_modelo": ["sepal_length_cm", "sepal_width_cm", "petal_length_cm", "petal_width_cm"]
  },
  "salida": {
    "campo": "prediccion",
    "tipo": "int",
    "valores_posibles": {
      "0": "setosa",
      "1": "versicolor",
      "2": "virginica"
    }
  },
  "ejemplo_entrada_valida": {
    "sepal_length_cm": 5.1,
    "sepal_width_cm": 3.5,
    "petal_length_cm": 1.4,
    "petal_width_cm": 0.2
  },
  "ejemplo_entrada_invalida": {
    "entrada": {
      "sepal_length_cm": "5.1",
      "sepal_width_cm": null,
      "petal_length_cm": 25.0,
      "color": "azul"
    },
    "motivos_del_rechazo": [
      "sepal_length_cm: tipo incorrecto (texto en lugar de número)",
      "sepal_width_cm: valor nulo no permitido",
      "petal_length_cm: fuera del rango lógico [0.5, 7.5]",
      "petal_width_cm: campo obligatorio ausente",
      "color: campo no definido en el contrato"
    ]
  }
